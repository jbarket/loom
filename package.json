{
  "name": "loomai",
  "version": "0.4.1",
  "description": "MCP server for persistent AI agent identity and memory. Single-file sqlite-vec + fastembed; zero external services.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "loom": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbarket/loom.git"
  },
  "homepage": "https://github.com/jbarket/loom#readme",
  "bugs": {
    "url": "https://github.com/jbarket/loom/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/build-widgets.mjs",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "agent",
    "identity",
    "memory",
    "persistent"
  ],
  "author": "Art E Fish + Jonathan Barket",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "fastembed": "^2.1.0",
    "preact": "^10.29.7",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
